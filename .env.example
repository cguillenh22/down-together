# CONFIGURACIÓN LOCAL
# ==================
# Copia este archivo como .env para probar la generación de contenido en local
#
# IMPORTANTE: El .env NUNCA se versiona en Git (está en .gitignore)
# En GitHub Actions, este valor va en Settings > Secrets and variables > Actions

# Obtén tu API key en: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Google Analytics (opcional - obtén en https://analytics.google.com)
# Formato: G-XXXXXXXXXX
PUBLIC_GA_ID=

# Base de datos (opcional - solo si usas backend local)
DATABASE_URL=postgresql://user:password@localhost:5432/down_together

# Puerto del servidor local (opcional)
PORT=3000
