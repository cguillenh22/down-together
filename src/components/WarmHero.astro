---
// Portada cálida de la home en español.
// Foto de archivo de Pexels (licencia Pexels, uso gratuito), optimizada en WebP.
// Paleta y tipografía viven en las variables --w-* de esta sección, así no
// afectan al resto del sitio mientras se revisa.
---
<section class="warm-hero" aria-labelledby="warm-hero-title">
  <div class="warm-copy">
    <h1 id="warm-hero-title">Acabas de recibir el diagnóstico. Respira: no estás solo.</h1>
    <p class="warm-lede">Respuestas verificadas, escritas por especialistas y revisadas por personas, en un lenguaje claro y sin prisas.</p>
    <div class="warm-actions">
      <a href="/es/empieza-aqui/" class="warm-btn warm-btn-primary">Empieza por aquí</a>
      <a href="#featured" class="warm-btn warm-btn-ghost">Guías esenciales</a>
    </div>
  </div>

  <figure class="warm-art">
    <img
      src="/images/familia-abrazo-patio.webp"
      width="1200"
      height="800"
      alt="Madre abrazando a su hija en un patio soleado"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <figcaption>Imagen de archivo con fines ilustrativos. Foto: RDNE Stock project, Pexels.</figcaption>
  </figure>
</section>

<style>
  .warm-hero {
    --w-bg: #fbf4ea;
    --w-ink: #3a2e27;
    --w-muted: #6b5346;
    --w-terra: #a94a33;
    --w-ochre: #e9a94b;
    --w-sage: #6e8b67;
    --w-clay: #f3e6d3;
    --w-sand: #e7d3b8;

    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 2rem;
    align-items: center;
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 4vw, 3rem);
    margin: 1rem 0 2rem;
    background: var(--w-bg);
    border-radius: 28px;
    color: var(--w-ink);
  }

  html[data-theme="dark"] .warm-hero {
    --w-bg: #241c18;
    --w-ink: #f6ebdc;
    --w-muted: #d9c7b3;
    --w-terra: #e07a5f;
    --w-ochre: #f2c15f;
    --w-sage: #9dbb93;
    --w-clay: #332820;
    --w-sand: #4a3b30;
  }

  .warm-copy h1 {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    font-size: clamp(2rem, 4.2vw, 2.9rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    margin: 0 0 1rem;
    text-wrap: balance;
    color: var(--w-ink);
  }

  .warm-lede {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--w-muted);
    max-width: 36ch;
    margin: 0 0 1.75rem;
    text-wrap: pretty;
  }

  .warm-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .warm-btn {
    display: inline-block;
    padding: 0.9rem 1.5rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .warm-btn-primary {
    background: var(--w-terra);
    color: #fff;
  }

  .warm-btn-ghost {
    color: var(--w-ink);
    box-shadow: inset 0 0 0 2px var(--w-sand);
  }

  .warm-btn:hover {
    transform: translateY(-2px);
  }

  .warm-btn:focus-visible {
    outline: 3px solid var(--w-ochre);
    outline-offset: 3px;
  }

  .warm-art {
    margin: 0;
  }

  .warm-art img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 20px;
  }

  .warm-art figcaption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--w-muted);
  }

  @media (max-width: 760px) {
    .warm-hero {
      grid-template-columns: 1fr;
      border-radius: 20px;
    }
    .warm-art { order: 2; width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .warm-btn { transition: none; }
  }
</style>
