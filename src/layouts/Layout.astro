---
interface Props {
  title: string;
  description?: string;
  lang?: 'es' | 'en';
  // Si esta página tiene una traducción específica (ej. un artículo con
  // translationSlug), pásala aquí para que "Cambiar idioma" lleve al
  // artículo traducido en vez de al home del otro idioma.
  switchHrefOverride?: string;
}
const { title, description = '', lang = 'es', switchHrefOverride } = Astro.props;

const nav = {
  es: {
    brand: 'Down Together',
    home: 'Inicio',
    empiezaAqui: 'Empieza aquí',
    basico: 'Lo básico',
    avanzado: 'Actualidad e investigación',
    metodologia: 'Sobre este sitio',
    switch: 'English',
    switchHref: '/en/',
    support: 'Apoya este proyecto',
  },
  en: {
    brand: 'Down Together',
    home: 'Home',
    empiezaAqui: 'Start here',
    basico: 'The basics',
    avanzado: 'News & research',
    metodologia: 'About this site',
    switch: 'Español',
    switchHref: '/es/',
    support: 'Support this project',
  },
};
const t = nav[lang];
const switchHref = switchHrefOverride || t.switchHref;
const empiezaAquiHref = lang === 'es' ? '/es/empieza-aqui/' : '/en/start-here/';
const metodologiaHref = lang === 'es' ? '/es/sobre-el-proyecto/' : '/en/about/';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <slot name="head" />
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "853e837f72674205847ee30c592163c0"}'></script>
    <script>
      if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
        document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
      });
      // Scroll animations
      const observer = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.style.animation = 'fadeInUp 0.6s ease-out';
            observer.unobserve(e.target);
          }
        });
      }, { threshold: 0.1 });
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.card, .related-card').forEach(el => observer.observe(el));
      });
    </script>
    <style is:global>
      :root {
        --blue: #2563EB;
        --yellow: #FBBF24;
        --orange: #F97316;
        --green: #10b981;
        --red: #dc2626;
        --purple: #a855f7;
        --bg-light: #ffffff;
        --bg-alt: #f3f4f6;
        --text-dark: #1f2937;
        --text-muted: #6b7280;
        --border-light: #e5e7eb;
        --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
        --shadow-md: 0 4px 6px rgba(0,0,0,0.1);
        --shadow-lg: 0 10px 15px rgba(0,0,0,0.15);
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      [data-theme="dark"] {
        --bg-light: #111827;
        --bg-alt: #1f2937;
        --text-dark: #f3f4f6;
        --text-muted: #d1d5db;
        --border-light: #374151;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes slideInDown {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
      }
      @keyframes parallax {
        0% { transform: translateY(0px); }
        100% { transform: translateY(20px); }
      }
      @keyframes ripple {
        0% { width: 0; height: 0; opacity: 1; }
        100% { width: 300px; height: 300px; opacity: 0; }
      }
      @keyframes shimmer {
        0% { background-position: -1000px 0; }
        100% { background-position: 1000px 0; }
      }
      .hero {
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.1) 0%, rgba(249, 115, 22, 0.1) 100%);
        border: 2px solid var(--border-light);
        border-radius: 20px;
        padding: 3rem 2rem;
        margin: 2rem 0;
        text-align: center;
        position: relative;
        overflow: hidden;
      }
      .hero::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(37, 99, 235, 0.1), transparent);
        border-radius: 50%;
        animation: parallax 6s ease-in-out infinite;
      }
      .hero-content {
        position: relative;
        z-index: 1;
      }
      .hero h1 {
        font-family: 'Poppins', sans-serif;
        font-size: 2.5rem;
        margin: 0 0 1rem;
        background: linear-gradient(135deg, var(--blue) 0%, var(--orange) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .hero p {
        font-size: 1.1rem;
        color: var(--text-muted);
        margin-bottom: 1.5rem;
      }
      .hero-cta {
        display: inline-block;
        padding: 1rem 2rem;
        background: linear-gradient(135deg, var(--blue), var(--purple));
        color: white;
        font-weight: 700;
        border-radius: 12px;
        text-decoration: none;
        transition: var(--transition);
        position: relative;
        overflow: hidden;
        box-shadow: var(--shadow-lg);
      }
      .hero-cta:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(37, 99, 235, 0.3);
      }
      .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1.5rem;
        margin: 2rem 0;
        padding: 2rem;
        background: var(--bg-alt);
        border-radius: 16px;
      }
      .stat {
        text-align: center;
        padding: 1rem;
      }
      .stat-number {
        font-family: 'Poppins', sans-serif;
        font-size: 2rem;
        font-weight: 700;
        background: linear-gradient(135deg, var(--blue), var(--orange));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .stat-label {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-top: 0.5rem;
      }
      .features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.5rem;
        margin: 2rem 0;
      }
      .feature-card {
        padding: 1.5rem;
        background: var(--bg-light);
        border: 2px solid var(--border-light);
        border-radius: 12px;
        text-align: center;
        transition: var(--transition);
        position: relative;
        overflow: hidden;
      }
      .feature-card::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        background: radial-gradient(circle, rgba(37, 99, 235, 0.1), transparent);
        border-radius: 50%;
        transform: translate(-50%, -50%);
        pointer-events: none;
      }
      .feature-card:hover {
        border-color: var(--blue);
        box-shadow: var(--shadow-lg);
        transform: translateY(-8px);
      }
      .feature-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
      }
      .feature-title {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: var(--text-dark);
      }
      .feature-desc {
        font-size: 0.9rem;
        color: var(--text-muted);
      }
      .blur-bg {
        backdrop-filter: blur(10px);
        background: rgba(255, 255, 255, 0.7);
      }
      [data-theme="dark"] .blur-bg {
        background: rgba(17, 24, 39, 0.7);
      }
      .gradient-heading {
        background: linear-gradient(135deg, var(--blue) 0%, var(--orange) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .category-tag {
        display: inline-block;
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 700;
        margin-right: 0.5rem;
      }
      .category-tag.health { background: rgba(16, 185, 129, 0.2); color: var(--green); }
      .category-tag.education { background: rgba(37, 99, 235, 0.2); color: var(--blue); }
      .category-tag.legal { background: rgba(249, 115, 22, 0.2); color: var(--orange); }
      /* Ultra-refinements animations & effects */
      .card {
        animation: fadeInUp 0.6s ease-out both;
      }
      .card:nth-child(1) { animation-delay: 0.1s; }
      .card:nth-child(2) { animation-delay: 0.2s; }
      .card:nth-child(3) { animation-delay: 0.3s; }
      .card:nth-child(n+4) { animation-delay: 0.4s; }
      .skeleton {
        background: linear-gradient(90deg, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0.5) 50%, rgba(255,255,255,0.3) 100%);
        background-size: 200% 100%;
        animation: shimmer 2s infinite;
      }
      .skeleton-line {
        height: 12px;
        border-radius: 4px;
        margin: 8px 0;
      }
      .premium-card {
        position: relative;
        border: 2px solid transparent;
        background: linear-gradient(var(--bg-light), var(--bg-light)) padding-box,
                    linear-gradient(135deg, var(--blue), var(--orange)) border-box;
        transition: var(--transition);
      }
      .premium-card:hover {
        box-shadow: 0 20px 40px rgba(37, 99, 235, 0.15);
        transform: translateY(-6px);
      }
      .scroll-reveal {
        opacity: 0;
        transform: translateY(30px);
      }
      .scroll-reveal.visible {
        opacity: 1;
        transform: translateY(0);
        transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      .badge-new {
        position: absolute;
        top: -10px;
        right: 20px;
        background: linear-gradient(135deg, var(--blue), var(--orange));
        color: white;
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 700;
        box-shadow: var(--shadow-md);
        animation: pulse 2s infinite;
      }
      .glass-effect {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
      }
      [data-theme="dark"] .glass-effect {
        background: rgba(17, 24, 39, 0.7);
        border-color: rgba(255, 255, 255, 0.1);
      }
      .gradient-text-primary {
        background: linear-gradient(135deg, var(--blue), var(--orange));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .gradient-text-secondary {
        background: linear-gradient(135deg, var(--yellow), var(--orange));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .glow-effect {
        box-shadow: 0 0 30px rgba(37, 99, 235, 0.2);
        transition: var(--transition);
      }
      .glow-effect:hover {
        box-shadow: 0 0 50px rgba(37, 99, 235, 0.4);
      }
      .link-hover-underline {
        position: relative;
        text-decoration: none;
        color: var(--blue);
      }
      .link-hover-underline::after {
        content: '';
        position: absolute;
        width: 0;
        height: 2px;
        bottom: -4px;
        left: 0;
        background: linear-gradient(90deg, var(--blue), var(--orange));
        transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .link-hover-underline:hover::after {
        width: 100%;
      }
      /* Social sharing & testimonials */
      .social-share {
        display: flex;
        gap: 1rem;
        margin: 2rem 0;
        justify-content: center;
      }
      .share-btn {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 1.2rem;
        transition: var(--transition);
        position: relative;
        overflow: hidden;
        border: 2px solid var(--border-light);
      }
      .share-btn:hover {
        border-color: var(--blue);
        transform: scale(1.1) rotateZ(5deg);
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.3);
      }
      .share-btn::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle, rgba(37, 99, 235, 0.2), transparent);
        transform: translate(-50%, -50%) scale(0);
        transition: transform 0.6s ease-out;
        pointer-events: none;
      }
      .share-btn:active::before {
        transform: translate(-50%, -50%) scale(2);
      }
      /* Testimonials carousel */
      .testimonials {
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.05) 0%, rgba(249, 115, 22, 0.05) 100%);
        border-radius: 16px;
        padding: 2.5rem 2rem;
        margin: 3rem 0;
        border: 2px solid rgba(37, 99, 235, 0.2);
      }
      .testimonials h2 {
        font-family: 'Poppins', sans-serif;
        text-align: center;
        margin-bottom: 2rem;
        font-size: 1.75rem;
      }
      .testimonial-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 2rem;
      }
      .testimonial-card {
        background: var(--bg-light);
        border-radius: 12px;
        padding: 1.5rem;
        border: 1px solid var(--border-light);
        transition: var(--transition);
        position: relative;
        animation: fadeInUp 0.6s ease-out both;
      }
      .testimonial-card:nth-child(1) { animation-delay: 0.1s; }
      .testimonial-card:nth-child(2) { animation-delay: 0.2s; }
      .testimonial-card:nth-child(3) { animation-delay: 0.3s; }
      .testimonial-card:hover {
        box-shadow: var(--shadow-lg);
        transform: translateY(-8px);
        border-color: var(--blue);
      }
      .testimonial-quote {
        font-size: 0.95rem;
        font-style: italic;
        color: var(--text-dark);
        margin-bottom: 1rem;
        line-height: 1.6;
      }
      .testimonial-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--blue), var(--yellow));
        margin-bottom: 1rem;
      }
      .testimonial-author {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--text-dark);
      }
      .testimonial-role {
        font-size: 0.8rem;
        color: var(--text-muted);
      }
      /* Advanced button states */
      button, a.button, .cta {
        position: relative;
        overflow: hidden;
        cursor: pointer;
      }
      button::before, a.button::before, .cta::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.3), transparent);
        border-radius: 50%;
        transform: translate(-50%, -50%);
        transition: width 0.6s, height 0.6s;
        pointer-events: none;
      }
      button:active::before, a.button:active::before, .cta:active::before {
        width: 300px;
        height: 300px;
      }
      /* Newsletter section */
      .newsletter {
        background: linear-gradient(135deg, var(--blue), var(--purple));
        border-radius: 16px;
        padding: 2.5rem 2rem;
        margin: 3rem 0;
        text-align: center;
        color: white;
        position: relative;
        overflow: hidden;
      }
      .newsletter::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.1), transparent);
        border-radius: 50%;
        animation: parallax 8s ease-in-out infinite;
      }
      .newsletter-content {
        position: relative;
        z-index: 1;
      }
      .newsletter h2 {
        font-family: 'Poppins', sans-serif;
        margin-bottom: 1rem;
        font-size: 1.75rem;
      }
      .newsletter p {
        margin-bottom: 1.5rem;
        opacity: 0.95;
      }
      .newsletter-form {
        display: flex;
        gap: 0.75rem;
        max-width: 400px;
        margin: 0 auto;
        flex-wrap: wrap;
        justify-content: center;
      }
      .newsletter-input {
        flex: 1;
        min-width: 200px;
        padding: 0.75rem 1rem;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: var(--transition);
      }
      .newsletter-input:focus {
        outline: none;
        box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.2);
      }
      .newsletter-submit {
        padding: 0.75rem 1.5rem;
        background: white;
        color: var(--blue);
        font-weight: 700;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: var(--transition);
      }
      .newsletter-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
      }
      /* Related articles enhanced */
      .related-articles {
        background: var(--bg-alt);
        border-radius: 12px;
        padding: 1.5rem;
        margin-top: 2rem;
        border: 2px solid var(--border-light);
      }
      .related-articles h3 {
        font-family: 'Poppins', sans-serif;
        margin-bottom: 1rem;
      }
      .related-card {
        padding: 1rem;
        background: var(--bg-light);
        border-radius: 8px;
        margin-bottom: 0.75rem;
        transition: var(--transition);
        border-left: 4px solid transparent;
      }
      .related-card:hover {
        border-left-color: var(--blue);
        box-shadow: var(--shadow-md);
        padding-left: 1.25rem;
      }
      .related-card a {
        text-decoration: none;
        color: var(--text-dark);
        font-weight: 600;
        transition: var(--transition);
      }
      .related-card a:hover {
        color: var(--blue);
      }
      /* Custom scrollbar */
      ::-webkit-scrollbar {
        width: 12px;
      }
      ::-webkit-scrollbar-track {
        background: var(--bg-alt);
      }
      ::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, var(--blue), var(--orange));
        border-radius: 6px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(180deg, var(--blue), var(--purple));
      }
      /* Enhanced typography */
      h1, h2, h3 {
        font-family: 'Poppins', sans-serif;
        letter-spacing: -0.02em;
      }
      h1 {
        font-size: 2.5rem;
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: -0.03em;
      }
      h2 {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-bottom: 1.5rem;
      }
      h3 {
        font-size: 1.5rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      p {
        line-height: 1.8;
        letter-spacing: 0.3px;
      }
      /* Enhanced focus states for accessibility */
      a:focus, button:focus, input:focus, textarea:focus, select:focus {
        outline: 3px solid var(--blue);
        outline-offset: 2px;
      }
      /* Image hover magnify */
      img {
        transition: var(--transition);
      }
      .card img:hover, .feature-card img:hover {
        transform: scale(1.05);
      }
      /* Enhanced links */
      a:not([class]) {
        color: var(--blue);
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 4px;
        transition: var(--transition);
      }
      a:not([class]):hover {
        color: var(--orange);
        text-decoration-color: var(--orange);
      }
      /* Staggered list animation */
      ul, ol {
        list-style-position: inside;
      }
      li {
        animation: fadeInUp 0.6s ease-out both;
      }
      li:nth-child(1) { animation-delay: 0.1s; }
      li:nth-child(2) { animation-delay: 0.2s; }
      li:nth-child(3) { animation-delay: 0.3s; }
      li:nth-child(n+4) { animation-delay: 0.4s; }
      /* Heading special effects */
      .subtitle {
        font-size: 1.1rem;
        color: var(--text-muted);
        margin-top: -0.5rem;
        margin-bottom: 2rem;
      }
      /* Quote styling */
      blockquote {
        border-left: 4px solid var(--blue);
        padding-left: 1.5rem;
        font-style: italic;
        color: var(--text-muted);
        margin: 1.5rem 0;
      }
      blockquote::before {
        content: '"';
        font-size: 3rem;
        color: var(--blue);
        opacity: 0.3;
        position: relative;
        top: -0.5rem;
      }
      /* Code block styling */
      code {
        background: var(--bg-alt);
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-family: 'Monaco', 'Menlo', monospace;
        font-size: 0.9rem;
        color: var(--orange);
      }
      pre {
        background: var(--bg-alt);
        padding: 1rem;
        border-radius: 8px;
        overflow-x: auto;
        border: 1px solid var(--border-light);
      }
      pre code {
        background: none;
        padding: 0;
        color: inherit;
      }
      /* Emphasized text */
      strong {
        font-weight: 700;
        color: var(--text-dark);
      }
      em {
        font-style: italic;
        color: var(--blue);
      }
      mark {
        background: rgba(251, 191, 36, 0.3);
        padding: 0.1rem 0.3rem;
        border-radius: 2px;
      }
      /* Table styling */
      table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
      }
      th {
        background: var(--bg-alt);
        padding: 0.75rem;
        text-align: left;
        font-weight: 700;
        border-bottom: 2px solid var(--blue);
      }
      td {
        padding: 0.75rem;
        border-bottom: 1px solid var(--border-light);
      }
      tr:hover {
        background: var(--bg-alt);
      }
      /* Small text enhancements */
      small {
        font-size: 0.85rem;
        color: var(--text-muted);
      }
      /* HR styling */
      hr {
        border: none;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--blue), transparent);
        margin: 2rem 0;
      }
      /* Smooth transitions */
      * {
        transition-property: background-color, color, border-color;
        transition-duration: 0.2s;
        transition-timing-function: ease;
      }
      /* Disable animations if user prefers reduced motion */
      @media (prefers-reduced-motion: reduce) {
        * {
          animation: none !important;
          transition: none !important;
        }
      }
      body {
        margin: 0;
        font-family: 'Inter', -apple-system, "Segoe UI", Roboto, sans-serif;
        background: var(--bg-light);
        color: var(--text-dark);
        line-height: 1.7;
        transition: background-color 0.3s, color 0.3s;
      }
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.5rem;
        border-bottom: 2px solid var(--border-light);
        background: var(--bg-light);
        position: sticky;
        top: 0;
        z-index: 100;
        box-shadow: var(--shadow-sm);
      }
      header a { color: var(--text-dark); text-decoration: none; transition: var(--transition); }
      .brand { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1.25rem; background: linear-gradient(135deg, var(--blue) 0%, var(--orange) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
      nav { display: flex; gap: 2rem; flex-wrap: wrap; }
      nav a { font-size: 0.95rem; color: var(--text-muted); position: relative; padding-bottom: 0.25rem; }
      nav a:hover { color: var(--blue); }
      nav a::after { content: ''; position: absolute; bottom: 0; left: 0; width: 0; height: 2px; background: var(--blue); transition: width 0.3s; }
      nav a:hover::after { width: 100%; }
      .logo-svg {
        width: 32px;
        height: 32px;
        margin-right: 0.75rem;
        vertical-align: middle;
        animation: logoFloat 3s ease-in-out infinite;
      }
      @keyframes logoFloat {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-4px); }
      }
      .search-bar {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 0 1rem;
      }
      .search-input {
        padding: 0.5rem 1rem;
        border: 2px solid var(--border-light);
        border-radius: 24px;
        font-size: 0.9rem;
        width: 200px;
        transition: var(--transition);
        background: var(--bg-alt);
        color: var(--text-dark);
      }
      .search-input:focus {
        outline: none;
        border-color: var(--blue);
        background: var(--bg-light);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
      }
      @media (max-width: 640px) {
        .search-bar { display: none; }
      }
      main { max-width: 800px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
      footer {
        margin-top: 4rem;
        padding: 3.5rem 1.5rem 2rem;
        background: linear-gradient(180deg, var(--bg-alt) 0%, var(--bg-light) 100%);
        border-top: 3px solid var(--border-light);
        color: var(--text-muted);
        font-size: 0.85rem;
      }
      footer-content {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
        max-width: 1200px;
        margin: 0 auto 2rem;
      }
      .footer-section h3 {
        font-family: 'Poppins', sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 1rem;
      }
      .footer-section p { margin: 0.5rem 0; line-height: 1.6; }
      .footer-section a { color: var(--blue); font-weight: 600; text-decoration: none; transition: var(--transition); }
      .footer-section a:hover { color: var(--orange); text-decoration: underline; }
      .footer-divider { border-top: 1px solid var(--border-light); padding-top: 1.5rem; margin-top: 1.5rem; text-align: center; }
      footer > p { margin: 0.5rem 0; }
      .card {
        background: var(--bg-light);
        border: 2px solid var(--border-light);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        box-shadow: var(--shadow-sm);
        transition: var(--transition);
        position: relative;
        overflow: hidden;
      }
      .card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--blue) 0%, var(--yellow) 50%, var(--orange) 100%);
        opacity: 0;
        transition: opacity 0.3s;
      }
      .card:hover {
        border-color: var(--blue);
        box-shadow: var(--shadow-lg);
        transform: translateY(-4px);
      }
      .card:hover::before { opacity: 1; }
      .card-pillar {
        border-left: 4px solid var(--green);
        background: linear-gradient(to right, rgba(16, 185, 129, 0.05), transparent);
      }
      .tag {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #fff;
        background: var(--blue);
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        margin-right: 0.5rem;
        margin-bottom: 0.5rem;
        text-decoration: none;
        transition: var(--transition);
        cursor: pointer;
      }
      a.tag:hover { background: var(--orange); transform: scale(1.05); }
      .breadcrumbs {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 1.5rem;
        padding: 0.75rem 1rem;
        background: var(--bg-alt);
        border-radius: 8px;
        width: fit-content;
      }
      .breadcrumbs a {
        color: var(--text-muted);
        text-decoration: none;
        transition: var(--transition);
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
      }
      .breadcrumbs a::before {
        content: '📁';
        opacity: 0;
        transition: opacity 0.3s;
      }
      .breadcrumbs a:hover {
        color: var(--blue);
      }
      .breadcrumbs a:hover::before {
        opacity: 1;
      }
      .breadcrumbs [aria-current="page"] {
        color: var(--text-dark);
        font-weight: 600;
        display: inline-block;
        max-width: 60ch;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        vertical-align: bottom;
        padding: 0.3rem 0.6rem;
        background: rgba(37, 99, 235, 0.1);
        border-radius: 4px;
      }
      .breadcrumb-sep {
        margin: 0 0.4rem;
        color: var(--border-light);
      }
      .category-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin: 1.5rem 0 2rem;
      }
      .category-pill {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-dark);
        background: var(--bg-alt);
        border: 2px solid var(--border-light);
        padding: 0.5rem 1rem;
        border-radius: 999px;
        text-decoration: none;
        transition: var(--transition);
        cursor: pointer;
      }
      .category-pill:hover { border-color: var(--blue); color: var(--blue); background: linear-gradient(135deg, rgba(37, 99, 235, 0.05), rgba(249, 115, 22, 0.05)); }
      .source-card {
        margin-top: 2rem;
        padding: 1.5rem;
        background: linear-gradient(to right, rgba(37, 99, 235, 0.05), transparent);
        border: 2px solid var(--blue);
        border-radius: 12px;
        transition: var(--transition);
      }
      .source-card:hover { box-shadow: var(--shadow-md); }
      .source-label {
        margin: 0 0 0.5rem;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 700;
        color: var(--blue);
        display: inline-block;
        background: rgba(37, 99, 235, 0.1);
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
      }
      .source-name { margin: 0.5rem 0 0.75rem; font-weight: 700; font-size: 1rem; color: var(--text-dark); }
      .source-link { color: var(--blue); font-weight: 600; text-decoration: none; transition: var(--transition); }
      .source-link:hover { color: var(--orange); text-decoration: underline; }
      .source-dates { margin: 0.6rem 0 0; font-size: 0.8rem; color: var(--muted); }
      .related { margin-top: 3rem; }
      .related h2 { font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; color: var(--text-dark); }
      .related-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.5rem;
      }
      .testimonials {
        margin: 3rem 0;
        padding: 2rem;
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.05), rgba(249, 115, 22, 0.05));
        border-radius: 16px;
        border: 2px solid var(--border-light);
      }
      .testimonials h2 {
        font-family: 'Poppins', sans-serif;
        font-size: 1.5rem;
        margin-bottom: 1.5rem;
        background: linear-gradient(135deg, var(--blue) 0%, var(--orange) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .testimonial-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
      }
      .testimonial {
        padding: 1.5rem;
        background: var(--bg-light);
        border: 1px solid var(--border-light);
        border-radius: 12px;
        transition: var(--transition);
      }
      .testimonial:hover {
        border-color: var(--blue);
        box-shadow: var(--shadow-md);
      }
      .testimonial-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--blue), var(--yellow));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
      }
      .testimonial-text {
        font-size: 0.9rem;
        font-style: italic;
        color: var(--text-muted);
        margin-bottom: 0.75rem;
      }
      .testimonial-name {
        font-weight: 700;
        color: var(--text-dark);
        font-size: 0.9rem;
      }
      .newsletter {
        margin: 2rem 0;
        padding: 2rem;
        background: linear-gradient(135deg, var(--blue) 0%, var(--purple) 100%);
        border-radius: 16px;
        color: white;
        text-align: center;
      }
      .newsletter h3 {
        font-family: 'Poppins', sans-serif;
        font-size: 1.25rem;
        margin: 0 0 0.5rem;
      }
      .newsletter p {
        margin-bottom: 1.5rem;
        opacity: 0.95;
      }
      .newsletter-form {
        display: flex;
        gap: 0.5rem;
        justify-content: center;
        flex-wrap: wrap;
      }
      .newsletter-input {
        padding: 0.75rem 1rem;
        border: none;
        border-radius: 8px;
        font-size: 0.9rem;
        width: 250px;
        background: rgba(255, 255, 255, 0.9);
      }
      .newsletter-button {
        padding: 0.75rem 1.5rem;
        background: var(--orange);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        transition: var(--transition);
      }
      .newsletter-button:hover {
        transform: scale(1.05);
        opacity: 0.9;
      }
      .social-links {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin: 1.5rem 0;
      }
      .social-link {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--bg-alt);
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: var(--transition);
        font-size: 1.2rem;
      }
      .social-link:hover {
        background: var(--blue);
        color: white;
        transform: translateY(-3px);
      }
      .category-icon {
        display: inline-block;
        margin-right: 0.5rem;
        font-size: 1.1em;
      }
      @media (max-width: 640px) {
        nav { gap: 1rem; }
        nav a { font-size: 0.85rem; }
        main { padding: 1.5rem 1rem 3rem; }
        .related-grid { grid-template-columns: 1fr; }
        .card { padding: 1rem; }
        .cta { flex-direction: column; }
        .cta a { width: 100%; justify-content: center; }
        .testimonial-grid { grid-template-columns: 1fr; }
        .newsletter-form { flex-direction: column; }
        .newsletter-input { width: 100%; }
      }
      .related-card {
        display: block;
        background: var(--bg-light);
        border: 2px solid var(--border-light);
        border-radius: 12px;
        padding: 1.25rem;
        text-decoration: none;
        color: var(--text-dark);
        transition: var(--transition);
      }
      .related-card:hover { border-color: var(--blue); background: var(--bg-alt); transform: translateY(-4px); box-shadow: var(--shadow-lg); }
      .related-card h3 { margin: 0.75rem 0 0; font-size: 0.95rem; font-weight: 700; }
      .cta {
        margin-top: 1.5rem;
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .cta a {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, var(--blue) 0%, var(--purple) 100%);
        color: #fff;
        font-weight: 700;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        text-decoration: none;
        transition: var(--transition);
        box-shadow: var(--shadow-md);
        border: none;
        cursor: pointer;
      }
      .cta a:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
      .cta a:active { transform: scale(0.98); }
      .pillar-badge {
        background: linear-gradient(135deg, rgba(251, 191, 36, 0.15), rgba(249, 115, 22, 0.15));
        color: var(--orange);
        font-weight: 700;
        padding: 0.35rem 0.75rem;
        border-radius: 6px;
        display: inline-block;
        font-size: 0.8rem;
      }
      a.title-link { color: var(--text-dark); text-decoration: none; transition: var(--transition); }
      a.title-link:hover { color: var(--blue); }
      .disclaimer {
        margin-top: 2rem;
        padding: 1rem 1.25rem;
        background: linear-gradient(135deg, rgba(251, 191, 36, 0.1), rgba(249, 115, 22, 0.1));
        border: 2px solid var(--yellow);
        border-radius: 10px;
        font-size: 0.9rem;
        color: var(--text-dark);
        font-weight: 500;
      }
      .source-list { margin: 0.75rem 0 0; padding-left: 1.25rem; }
      .source-list li { margin-bottom: 0.5rem; }
      .source-list a { color: var(--blue); font-weight: 600; text-decoration: none; transition: var(--transition); }
      .source-list a:hover { color: var(--orange); text-decoration: underline; }
      .source-country { color: var(--text-muted); font-size: 0.85rem; }
      .reviewer-line { margin-top: 0.5rem; font-weight: 500; }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href={lang === 'es' ? '/es/' : '/en/'}>
        <svg class="logo-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <circle cx="35" cy="35" r="25" fill="#2563EB" opacity="0.8"/>
          <circle cx="65" cy="35" r="25" fill="#FBBF24"/>
          <circle cx="50" cy="65" r="25" fill="#F97316" opacity="0.8"/>
        </svg>
        {t.brand}
      </a>
      <div class="search-bar">
        <input type="search" class="search-input" placeholder={lang === 'es' ? 'Buscar...' : 'Search...'} />
      </div>
      <nav>
        <a href={empiezaAquiHref}>{t.empiezaAqui}</a>
        <a href={lang === 'es' ? '/es/#basico' : '/en/#basico'}>{t.basico}</a>
        <a href={lang === 'es' ? '/es/#avanzado' : '/en/#avanzado'}>{t.avanzado}</a>
        <a href={metodologiaHref}>{t.metodologia}</a>
        <a href={switchHref}>{t.switch}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="newsletter">
        <h3>{lang === 'es' ? 'Suscríbete' : 'Subscribe'}</h3>
        <p>{lang === 'es' ? 'Recibe actualizaciones sobre síndrome de Down' : 'Get updates about Down syndrome'}</p>
        <div class="newsletter-form">
          <input type="email" class="newsletter-input" placeholder="tu@email.com" />
          <button class="newsletter-button">{lang === 'es' ? 'Enviar' : 'Send'}</button>
        </div>
      </div>

      <div class="social-links">
        <a href="https://twitter.com" class="social-link" title="Twitter" target="_blank" rel="noopener noreferrer">𝕏</a>
        <a href="https://facebook.com" class="social-link" title="Facebook" target="_blank" rel="noopener noreferrer">f</a>
        <a href="https://instagram.com" class="social-link" title="Instagram" target="_blank" rel="noopener noreferrer">📷</a>
        <a href="https://linkedin.com" class="social-link" title="LinkedIn" target="_blank" rel="noopener noreferrer">in</a>
      </div>

      <div class="footer-divider">
        <p>Contenido generado con asistencia de Claude a partir de fuentes verificadas, revisado y aprobado por un humano antes de publicarse. / Content drafted with Claude from verified sources, human-reviewed before publishing.</p>
        <p>
          <a href="https://ko-fi.com/downtogether" target="_blank" rel="noopener noreferrer">☕ {t.support}</a>
        </p>
      </div>
    </footer>
  </body>
</html>
