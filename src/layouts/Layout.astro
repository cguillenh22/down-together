---
interface Props {
  title: string;
  description?: string;
  lang?: 'es' | 'en';
  // Si esta página tiene una traducción específica (ej. un artículo con
  // translationSlug), pásala aquí para que "Cambiar idioma" lleve al
  // artículo traducido en vez de al home del otro idioma.
  switchHrefOverride?: string;
}
const { title, description = '', lang = 'es', switchHrefOverride } = Astro.props;

const nav = {
  es: {
    brand: 'Down Together',
    home: 'Inicio',
    empiezaAqui: 'Empieza aquí',
    basico: 'Lo básico',
    avanzado: 'Actualidad e investigación',
    metodologia: 'Sobre este sitio',
    switch: 'English',
    switchHref: '/en/',
    support: 'Apoya este proyecto',
  },
  en: {
    brand: 'Down Together',
    home: 'Home',
    empiezaAqui: 'Start here',
    basico: 'The basics',
    avanzado: 'News & research',
    metodologia: 'About this site',
    switch: 'Español',
    switchHref: '/es/',
    support: 'Support this project',
  },
};
const t = nav[lang];
const switchHref = switchHrefOverride || t.switchHref;
const empiezaAquiHref = lang === 'es' ? '/es/empieza-aqui/' : '/en/start-here/';
const metodologiaHref = lang === 'es' ? '/es/sobre-el-proyecto/' : '/en/about/';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <slot name="head" />
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "853e837f72674205847ee30c592163c0"}'></script>
    <script>
      if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
        document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
      });
    </script>
    <style is:global>
      :root {
        --blue: #2563EB;
        --yellow: #FBBF24;
        --orange: #F97316;
        --green: #10b981;
        --red: #dc2626;
        --purple: #a855f7;
        --bg-light: #ffffff;
        --bg-alt: #f3f4f6;
        --text-dark: #1f2937;
        --text-muted: #6b7280;
        --border-light: #e5e7eb;
        --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
        --shadow-md: 0 4px 6px rgba(0,0,0,0.1);
        --shadow-lg: 0 10px 15px rgba(0,0,0,0.15);
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      [data-theme="dark"] {
        --bg-light: #111827;
        --bg-alt: #1f2937;
        --text-dark: #f3f4f6;
        --text-muted: #d1d5db;
        --border-light: #374151;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: 'Inter', -apple-system, "Segoe UI", Roboto, sans-serif;
        background: var(--bg-light);
        color: var(--text-dark);
        line-height: 1.7;
        transition: background-color 0.3s, color 0.3s;
      }
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.5rem;
        border-bottom: 2px solid var(--border-light);
        background: var(--bg-light);
        position: sticky;
        top: 0;
        z-index: 100;
        box-shadow: var(--shadow-sm);
      }
      header a { color: var(--text-dark); text-decoration: none; transition: var(--transition); }
      .brand { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1.25rem; background: linear-gradient(135deg, var(--blue) 0%, var(--orange) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
      nav { display: flex; gap: 2rem; flex-wrap: wrap; }
      nav a { font-size: 0.95rem; color: var(--text-muted); position: relative; padding-bottom: 0.25rem; }
      nav a:hover { color: var(--blue); }
      nav a::after { content: ''; position: absolute; bottom: 0; left: 0; width: 0; height: 2px; background: var(--blue); transition: width 0.3s; }
      nav a:hover::after { width: 100%; }
      main { max-width: 800px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
      footer {
        margin-top: 4rem;
        padding: 3rem 1.5rem 2rem;
        background: var(--bg-alt);
        border-top: 2px solid var(--border-light);
        color: var(--text-muted);
        font-size: 0.85rem;
      }
      footer > p { margin: 0.5rem 0; }
      footer a { color: var(--blue); font-weight: 600; text-decoration: none; transition: var(--transition); }
      footer a:hover { color: var(--orange); text-decoration: underline; }
      .card {
        background: var(--bg-light);
        border: 2px solid var(--border-light);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        box-shadow: var(--shadow-sm);
        transition: var(--transition);
      }
      .card:hover { border-color: var(--blue); box-shadow: var(--shadow-lg); transform: translateY(-2px); }
      .card-pillar {
        border-left: 4px solid var(--green);
        background: linear-gradient(to right, rgba(16, 185, 129, 0.05), transparent);
      }
      .tag {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #fff;
        background: var(--blue);
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        margin-right: 0.5rem;
        margin-bottom: 0.5rem;
        text-decoration: none;
        transition: var(--transition);
        cursor: pointer;
      }
      a.tag:hover { background: var(--orange); transform: scale(1.05); }
      .breadcrumbs {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 1.5rem;
      }
      .breadcrumbs a { color: var(--text-muted); text-decoration: none; transition: var(--transition); }
      .breadcrumbs a:hover { color: var(--blue); text-decoration: underline; }
      .breadcrumbs [aria-current="page"] {
        color: var(--text-dark);
        font-weight: 600;
        display: inline-block;
        max-width: 60ch;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        vertical-align: bottom;
      }
      .breadcrumb-sep { margin: 0 0.4rem; color: var(--border-light); }
      .category-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin: 1.5rem 0 2rem;
      }
      .category-pill {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-dark);
        background: var(--bg-alt);
        border: 2px solid var(--border-light);
        padding: 0.5rem 1rem;
        border-radius: 999px;
        text-decoration: none;
        transition: var(--transition);
        cursor: pointer;
      }
      .category-pill:hover { border-color: var(--blue); color: var(--blue); background: linear-gradient(135deg, rgba(37, 99, 235, 0.05), rgba(249, 115, 22, 0.05)); }
      .source-card {
        margin-top: 2rem;
        padding: 1.5rem;
        background: linear-gradient(to right, rgba(37, 99, 235, 0.05), transparent);
        border: 2px solid var(--blue);
        border-radius: 12px;
        transition: var(--transition);
      }
      .source-card:hover { box-shadow: var(--shadow-md); }
      .source-label {
        margin: 0 0 0.5rem;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 700;
        color: var(--blue);
        display: inline-block;
        background: rgba(37, 99, 235, 0.1);
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
      }
      .source-name { margin: 0.5rem 0 0.75rem; font-weight: 700; font-size: 1rem; color: var(--text-dark); }
      .source-link { color: var(--blue); font-weight: 600; text-decoration: none; transition: var(--transition); }
      .source-link:hover { color: var(--orange); text-decoration: underline; }
      .source-dates { margin: 0.6rem 0 0; font-size: 0.8rem; color: var(--muted); }
      .related { margin-top: 3rem; }
      .related h2 { font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; color: var(--text-dark); }
      .related-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.5rem;
      }
      @media (max-width: 640px) {
        nav { gap: 1rem; }
        nav a { font-size: 0.85rem; }
        main { padding: 1.5rem 1rem 3rem; }
        .related-grid { grid-template-columns: 1fr; }
        .card { padding: 1rem; }
        .cta { flex-direction: column; }
        .cta a { width: 100%; justify-content: center; }
      }
      .related-card {
        display: block;
        background: var(--bg-light);
        border: 2px solid var(--border-light);
        border-radius: 12px;
        padding: 1.25rem;
        text-decoration: none;
        color: var(--text-dark);
        transition: var(--transition);
      }
      .related-card:hover { border-color: var(--blue); background: var(--bg-alt); transform: translateY(-4px); box-shadow: var(--shadow-lg); }
      .related-card h3 { margin: 0.75rem 0 0; font-size: 0.95rem; font-weight: 700; }
      .cta {
        margin-top: 1.5rem;
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .cta a {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, var(--blue) 0%, var(--purple) 100%);
        color: #fff;
        font-weight: 700;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        text-decoration: none;
        transition: var(--transition);
        box-shadow: var(--shadow-md);
        border: none;
        cursor: pointer;
      }
      .cta a:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
      .cta a:active { transform: scale(0.98); }
      .pillar-badge {
        background: linear-gradient(135deg, rgba(251, 191, 36, 0.15), rgba(249, 115, 22, 0.15));
        color: var(--orange);
        font-weight: 700;
        padding: 0.35rem 0.75rem;
        border-radius: 6px;
        display: inline-block;
        font-size: 0.8rem;
      }
      a.title-link { color: var(--text-dark); text-decoration: none; transition: var(--transition); }
      a.title-link:hover { color: var(--blue); }
      .disclaimer {
        margin-top: 2rem;
        padding: 1rem 1.25rem;
        background: linear-gradient(135deg, rgba(251, 191, 36, 0.1), rgba(249, 115, 22, 0.1));
        border: 2px solid var(--yellow);
        border-radius: 10px;
        font-size: 0.9rem;
        color: var(--text-dark);
        font-weight: 500;
      }
      .source-list { margin: 0.75rem 0 0; padding-left: 1.25rem; }
      .source-list li { margin-bottom: 0.5rem; }
      .source-list a { color: var(--blue); font-weight: 600; text-decoration: none; transition: var(--transition); }
      .source-list a:hover { color: var(--orange); text-decoration: underline; }
      .source-country { color: var(--text-muted); font-size: 0.85rem; }
      .reviewer-line { margin-top: 0.5rem; font-weight: 500; }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href={lang === 'es' ? '/es/' : '/en/'}>{t.brand}</a>
      <nav>
        <a href={empiezaAquiHref}>{t.empiezaAqui}</a>
        <a href={lang === 'es' ? '/es/#basico' : '/en/#basico'}>{t.basico}</a>
        <a href={lang === 'es' ? '/es/#avanzado' : '/en/#avanzado'}>{t.avanzado}</a>
        <a href={metodologiaHref}>{t.metodologia}</a>
        <a href={switchHref}>{t.switch}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>Contenido generado con asistencia de Claude a partir de fuentes verificadas, revisado y aprobado por un humano antes de publicarse. / Content drafted with Claude from verified sources, human-reviewed before publishing.</p>
      <p>
        <a href="https://ko-fi.com/downtogether" target="_blank" rel="noopener noreferrer">☕ {t.support}</a>
      </p>
    </footer>
  </body>
</html>
