---
import Layout from '../../layouts/Layout.astro';
import HreflangHead from '../../components/HreflangHead.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SourceCard from '../../components/SourceCard.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { getCollection, render } from 'astro:content';
import { CATEGORY_LABELS, ETAPA_LABELS, categoryHref } from '../../lib/taxonomy.js';

const ETAPA_LABELS_EN = ETAPA_LABELS.en;

export async function getStaticPaths() {
  const entries = (await getCollection('articles')).filter(
    (e) => e.slug.startsWith('en/') && e.data.reviewed
  );
  return entries.map((entry) => ({
    params: { slug: entry.slug.replace(/^en\//, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Find the Spanish version of this same article by translationSlug, so
// "Switch language" links to the translated article, not just the home page.
const allEntries = await getCollection('articles');
const translated = allEntries.find(
  (e) => e.slug.startsWith('es/') && e.data.reviewed && e.data.translationSlug === entry.data.translationSlug
);
const switchHrefOverride = translated ? `/es/${translated.slug.replace(/^es\//, '')}/` : undefined;
const currentPath = `/en/${entry.slug.replace(/^en\//, '')}/`;
---
<Layout
  lang="en"
  title={`${entry.data.title} — Down Together`}
  description={entry.data.description}
  switchHrefOverride={switchHrefOverride}
>
  <Fragment slot="head">
    <HreflangHead lang="en" path={currentPath} translatedPath={switchHrefOverride} />
    <ArticleSchema entry={entry} />
  </Fragment>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/en/' },
      { label: CATEGORY_LABELS.en[entry.data.category], href: categoryHref('en', entry.data.category) },
      { label: entry.data.title },
    ]}
  />
  <a class="tag" href={categoryHref('en', entry.data.category)}>{CATEGORY_LABELS.en[entry.data.category]}</a>
  <span class="tag">{entry.data.level === 'basico' ? 'The basics' : 'News & research'}</span>
  <span class="tag">{ETAPA_LABELS_EN[entry.data.etapa]}</span>
  {entry.data.pillar && <span class="tag">📌 In-depth guide</span>}
  <h1>{entry.data.title}</h1>
  <Content />

  {entry.data.actionLabel && entry.data.actionUrl && (
    <p class="cta">
      <a href={entry.data.actionUrl} target="_blank" rel="noopener noreferrer">
        {entry.data.actionLabel} →
      </a>
    </p>
  )}

  <SourceCard entry={entry} lang="en" />
  <RelatedArticles entry={entry} allEntries={allEntries} lang="en" />
</Layout>
