---
import Layout from '../../layouts/Layout.astro';
import HreflangHead from '../../components/HreflangHead.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SourceCard from '../../components/SourceCard.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { getCollection, render } from 'astro:content';
import { CATEGORY_LABELS, ETAPA_LABELS, categoryHref } from '../../lib/taxonomy.js';

const ETAPA_LABELS_ES = ETAPA_LABELS.es;

export async function getStaticPaths() {
  const entries = (await getCollection('articles')).filter(
    (e) => e.slug.startsWith('es/') && e.data.reviewed
  );
  return entries.map((entry) => ({
    params: { slug: entry.slug.replace(/^es\//, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Busca la versión en inglés del mismo artículo por translationSlug, para
// que "Cambiar idioma" lleve al artículo traducido y no solo al home.
const allEntries = await getCollection('articles');
const translated = allEntries.find(
  (e) => e.slug.startsWith('en/') && e.data.reviewed && e.data.translationSlug === entry.data.translationSlug
);
const switchHrefOverride = translated ? `/en/${translated.slug.replace(/^en\//, '')}/` : undefined;
const currentPath = `/es/${entry.slug.replace(/^es\//, '')}/`;
---
<Layout
  lang="es"
  title={`${entry.data.title} — Down Together`}
  description={entry.data.description}
  switchHrefOverride={switchHrefOverride}
>
  <Fragment slot="head">
    <HreflangHead lang="es" path={currentPath} translatedPath={switchHrefOverride} />
    <ArticleSchema entry={entry} />
  </Fragment>
  <Breadcrumbs
    items={[
      { label: 'Inicio', href: '/es/' },
      { label: CATEGORY_LABELS.es[entry.data.category], href: categoryHref('es', entry.data.category) },
      { label: entry.data.title },
    ]}
  />
  <a class="tag" href={categoryHref('es', entry.data.category)}>{CATEGORY_LABELS.es[entry.data.category]}</a>
  <span class="tag">{entry.data.level === 'basico' ? 'Lo básico' : 'Actualidad e investigación'}</span>
  <span class="tag">{ETAPA_LABELS_ES[entry.data.etapa]}</span>
  {entry.data.pillar && <span class="tag">📌 Guía completa</span>}
  <h1>{entry.data.title}</h1>
  <Content />

  {entry.data.actionLabel && entry.data.actionUrl && (
    <p class="cta">
      <a href={entry.data.actionUrl} target="_blank" rel="noopener noreferrer">
        {entry.data.actionLabel} →
      </a>
    </p>
  )}

  <SourceCard entry={entry} lang="es" />
  <RelatedArticles entry={entry} allEntries={allEntries} lang="es" />
</Layout>
