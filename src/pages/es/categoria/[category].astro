---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, CATEGORY_LABELS, ETAPA_LABELS } from '../../../lib/taxonomy.js';

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const label = CATEGORY_LABELS.es[category];

const entries = (await getCollection('articles'))
  .filter((e) => e.slug.startsWith('es/') && e.data.reviewed && e.data.category === category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function localSlug(entry) {
  return entry.slug.replace(/^es\//, '');
}
---
<Layout
  lang="es"
  title={`${label} — Down Together`}
  description={`Artículos sobre ${label.toLowerCase()} relacionados con síndrome de Down, de fuentes verificadas.`}
>
  <Breadcrumbs items={[{ label: 'Inicio', href: '/es/' }, { label }]} />
  <h1>{label}</h1>
  {entries.length === 0 && <p><em>Aún no hay artículos publicados en esta categoría.</em></p>}
  {entries.map((entry) => (
    <div class={`card ${entry.data.pillar ? 'card-pillar' : ''}`}>
      <span class="tag">{ETAPA_LABELS.es[entry.data.etapa]}</span>
      {entry.data.pillar && <span class="tag pillar-badge">📌 Guía completa</span>}
      <h3><a class="title-link" href={`/es/${localSlug(entry)}/`}>{entry.data.title}</a></h3>
      <p>{entry.data.description}</p>
    </div>
  ))}
</Layout>
