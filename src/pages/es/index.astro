---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, CATEGORY_LABELS, ETAPA_LABELS, categoryHref } from '../../lib/taxonomy.js';

const ETAPA_LABELS_ES = ETAPA_LABELS.es;

const all = (await getCollection('articles'))
  .filter((e) => e.slug.startsWith('es/') && e.data.reviewed)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const basico = all.filter((e) => e.data.level === 'basico');
const avanzado = all.filter((e) => e.data.level === 'avanzado');
const pillar = all.filter((e) => e.data.pillar).slice(0, 5);

function localSlug(entry) {
  return entry.slug.replace(/^es\//, '');
}
---
<Layout
  lang="es"
  title="Down Together — Información sobre síndrome de Down en español"
  description="Fuente en español sobre síndrome de Down: fundamentos para familias que recién reciben el diagnóstico, y noticias e investigación para quienes ya están informados."
>
  <!-- PÁGINA CON SIDEBAR -->
  <div class="page-with-sidebar">
    <!-- SIDEBAR NAVIGATION (Desktop sticky, Mobile toggle) -->
    <aside class="sidebar-nav">
      <button id="toggle-sidebar" class="toggle-sidebar-btn" aria-label="Toggle navigation">☰</button>

      <nav class="sidebar-content">
        <h3>🔍 Filtros</h3>

        <!-- Filtro por categoría -->
        <div class="filter-group">
          <label class="filter-label">📂 Categoría</label>
          <div class="filter-options">
            <label class="filter-checkbox">
              <input type="radio" name="category" value="all" checked /> Todas
            </label>
            <label class="filter-checkbox">
              <input type="radio" name="category" value="salud" /> 🏥 Salud
            </label>
            <label class="filter-checkbox">
              <input type="radio" name="category" value="educacion" /> 📚 Educación
            </label>
            <label class="filter-checkbox">
              <input type="radio" name="category" value="desarrollo" /> 👶 Desarrollo
            </label>
            <label class="filter-checkbox">
              <input type="radio" name="category" value="inclusion-laboral" /> 💼 Inclusión Laboral
            </label>
            <label class="filter-checkbox">
              <input type="radio" name="category" value="investigacion" /> 🔬 Investigación
            </label>
            <label class="filter-checkbox">
              <input type="radio" name="category" value="testimonios" /> 💬 Testimonios
            </label>
            <label class="filter-checkbox">
              <input type="radio" name="category" value="legal-derechos" /> ⚖️ Legal y Derechos
            </label>
          </div>
        </div>

        <!-- Filtro por etapa -->
        <div class="filter-group">
          <label class="filter-label">🎂 Etapa de vida</label>
          <div class="filter-options">
            <label class="filter-checkbox">
              <input type="radio" name="etapa" value="all" checked /> Todas
            </label>
            <label class="filter-checkbox">
              <input type="radio" name="etapa" value="embarazo" /> 🤰 Embarazo
            </label>
            <label class="filter-checkbox">
              <input type="radio" name="etapa" value="recien-nacido" /> 👶 0-3 años
            </label>
            <label class="filter-checkbox">
              <input type="radio" name="etapa" value="infancia" /> 👧 3-8 años
            </label>
            <label class="filter-checkbox">
              <input type="radio" name="etapa" value="pre-adolescencia" /> 👦 8-12 años
            </label>
            <label class="filter-checkbox">
              <input type="radio" name="etapa" value="adolescencia" /> 🧑 12-18 años
            </label>
            <label class="filter-checkbox">
              <input type="radio" name="etapa" value="vida-adulta" /> 👨 18+ años
            </label>
          </div>
        </div>

        <!-- Filtro por nivel -->
        <div class="filter-group">
          <label class="filter-label">📖 Nivel</label>
          <div class="filter-options">
            <label class="filter-checkbox">
              <input type="radio" name="level" value="all" checked /> Todos
            </label>
            <label class="filter-checkbox">
              <input type="radio" name="level" value="basico" /> 🌱 Lo básico (nuevo)
            </label>
            <label class="filter-checkbox">
              <input type="radio" name="level" value="avanzado" /> 📈 Actualidad (experto)
            </label>
          </div>
        </div>

        <button id="clear-filters" class="clear-filters-btn">Limpiar filtros</button>
      </nav>

      <!-- QUICK STATS -->
      <div class="sidebar-stats">
        <div class="stat-item">
          <span class="stat-label">Artículos</span>
          <span class="stat-value" id="article-count">0</span>
        </div>
        <div class="stat-item">
          <span class="stat-label">Categorías</span>
          <span class="stat-value">7</span>
        </div>
        <div class="stat-item">
          <span class="stat-label">Etapas</span>
          <span class="stat-value">6</span>
        </div>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content">
      <!-- HERO URGIDA: Para personas en crisis (40% del tráfico) -->
      <section class="hero-urgida">
    <div class="hero-urgida-content">
      <h1 class="gradient-text-primary">Acabas de recibir el diagnóstico</h1>
      <p class="hero-urgida-subtitle">No estás solo. Aquí encontrarás respuestas verificadas, escritas por expertos y revisadas por humanos.</p>

      <div class="hero-urgida-ctas">
        <a href="/es/empieza-aqui/" class="cta-primary">🎯 Primeros pasos (lee esto primero)</a>
        <a href="#featured" class="cta-secondary">📚 Guías essenciales</a>
        <a href="#por-etapa" class="cta-tertiary">🔍 Busca por edad/etapa</a>
      </div>
    </div>
  </section>

  <!-- BÚSQUEDA RÁPIDA -->
  <section class="search-hero">
    <input type="text" id="quick-search" class="quick-search-input" placeholder="Busca: 'educación', 'salud', 'derechos', 'adolescencia'..." />
    <div id="search-results" class="search-results hidden"></div>
  </section>

  <!-- NAVEGACIÓN POR ETAPA DE VIDA -->
  <section id="por-etapa" class="etapa-navigator">
    <h2>¿Cuántos años tiene tu hijo?</h2>
    <p>Encuentra artículos específicos para cada etapa</p>
    <div class="etapa-grid">
      <a href="#" class="etapa-card" data-etapa="embarazo">
        <span class="etapa-icon">🤰</span>
        <strong>Embarazo</strong>
        <small>Diagnóstico prenatal</small>
      </a>
      <a href="#" class="etapa-card" data-etapa="recien-nacido">
        <span class="etapa-icon">👶</span>
        <strong>0-3 años</strong>
        <small>Primeros pasos</small>
      </a>
      <a href="#" class="etapa-card" data-etapa="infancia">
        <span class="etapa-icon">👧</span>
        <strong>3-8 años</strong>
        <small>Desarrollo clave</small>
      </a>
      <a href="#" class="etapa-card" data-etapa="pre-adolescencia">
        <span class="etapa-icon">👦</span>
        <strong>8-12 años</strong>
        <small>Escuela primaria</small>
      </a>
      <a href="#" class="etapa-card" data-etapa="adolescencia">
        <span class="etapa-icon">🧑</span>
        <strong>12-18 años</strong>
        <small>Transición</small>
      </a>
      <a href="#" class="etapa-card" data-etapa="vida-adulta">
        <span class="etapa-icon">👨</span>
        <strong>18+ años</strong>
        <small>Vida independiente</small>
      </a>
    </div>
  </section>

  <!-- ARTÍCULOS DESTACADOS (TOP 5 PILARES) -->
  {pillar.length > 0 && (
    <section id="featured" class="featured-section">
      <h2>📌 Guías Essenciales (Lee primero)</h2>
      <p>Los 5 artículos más importantes para entender síndrome de Down</p>
      <div class="featured-grid">
        {pillar.map((entry) => (
          <article class="featured-card premium-card">
            <span class="badge-new">Essencial</span>
            <span class="tag">{CATEGORY_LABELS.es[entry.data.category]}</span>
            <span class="tag">{ETAPA_LABELS_ES[entry.data.etapa]}</span>
            <h3><a href={`/es/${localSlug(entry)}/`}>{entry.data.title}</a></h3>
            <p>{entry.data.description}</p>
            <a href={`/es/${localSlug(entry)}/`} class="read-more">Leer artículo →</a>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- CATEGORÍAS RÁPIDAS -->
  <section class="categories-quick">
    <h2>Explora por tema</h2>
    <nav class="category-nav" aria-label="Categorías">
      {CATEGORIES.map((cat) => (
        <a href={categoryHref('es', cat)} class="category-pill">{CATEGORY_LABELS.es[cat]}</a>
      ))}
    </nav>
  </section>

  <h2 id="basico">Lo básico</h2>
  <p>Preguntas frecuentes y fundamentos, pensado para quienes recién reciben el diagnóstico.</p>
  {basico.length === 0 && <p><em>Aún no hay artículos publicados en esta sección.</em></p>}
  {basico.map((entry) => (
    <div class={`card ${entry.data.pillar ? 'card-pillar' : ''}`} data-category={entry.data.category} data-etapa={entry.data.etapa} data-level="basico">
      <a class="tag" href={categoryHref('es', entry.data.category)}>{CATEGORY_LABELS.es[entry.data.category]}</a>
      <span class="tag">{ETAPA_LABELS_ES[entry.data.etapa]}</span>
      {entry.data.pillar && <span class="tag pillar-badge">📌 Guía completa</span>}
      <h3><a class="title-link" href={`/es/${localSlug(entry)}/`}>{entry.data.title}</a></h3>
      <p>{entry.data.description}</p>
    </div>
  ))}

  <h2 id="avanzado">Actualidad e investigación</h2>
  <p>Noticias, estudios y avances, para quienes ya conocen lo básico.</p>
  {avanzado.length === 0 && <p><em>Aún no hay artículos publicados en esta sección.</em></p>}
  {avanzado.map((entry) => (
    <div class={`card ${entry.data.pillar ? 'card-pillar' : ''}`} data-category={entry.data.category} data-etapa={entry.data.etapa} data-level="avanzado">
      <a class="tag" href={categoryHref('es', entry.data.category)}>{CATEGORY_LABELS.es[entry.data.category]}</a>
      <span class="tag">{ETAPA_LABELS_ES[entry.data.etapa]}</span>
      {entry.data.pillar && <span class="tag pillar-badge">📌 Guía completa</span>}
      <h3><a class="title-link" href={`/es/${localSlug(entry)}/`}>{entry.data.title}</a></h3>
      <p>{entry.data.description}</p>
    </div>
  ))}

  <!-- BÚSQUEDA Y FILTROS EN JAVASCRIPT -->
  <script is:inline define:vars={{ articles: JSON.stringify(all.map(e => ({ title: e.data.title, description: e.data.description, category: e.data.category, etapa: e.data.etapa, url: `/es/${e.slug.replace(/^es\//, '')}/`, pillar: e.data.pillar }))) }}>
    const allArticles = JSON.parse(articles);
    const searchInput = document.getElementById('quick-search');
    const searchResults = document.getElementById('search-results');
    const etapaCards = document.querySelectorAll('.etapa-card');

    // Búsqueda rápida
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase();
        if (query.length < 2) {
          searchResults.classList.add('hidden');
          return;
        }

        const results = allArticles.filter(a =>
          a.title.toLowerCase().includes(query) ||
          a.description.toLowerCase().includes(query) ||
          a.category.toLowerCase().includes(query)
        ).slice(0, 5);

        searchResults.innerHTML = results.map(r =>
          `<a href="${r.url}" class="search-result-item">
            <strong>${r.title}</strong>
            <small>${r.description}</small>
          </a>`
        ).join('');
        searchResults.classList.toggle('hidden', results.length === 0);
      });
    }

    // Filtro por etapa
    etapaCards.forEach(card => {
      card.addEventListener('click', (e) => {
        e.preventDefault();
        const etapa = card.dataset.etapa;
        const filtered = allArticles.filter(a => a.etapa === etapa);

        // Scroll a sección básico y filtrar visualmente
        document.getElementById('basico')?.scrollIntoView({ behavior: 'smooth' });

        // Marker visual
        etapaCards.forEach(c => c.classList.remove('active'));
        card.classList.add('active');
      });
    });
  </script>

  <style>
    .hero-urgida {
      background: linear-gradient(135deg, rgba(37, 99, 235, 0.1) 0%, rgba(249, 115, 22, 0.1) 100%);
      border: 2px solid var(--border-light);
      border-radius: 20px;
      padding: 3rem 2rem;
      margin: 2rem 0;
      text-align: center;
    }

    .hero-urgida h1 {
      font-size: 2.5rem;
      margin: 0 0 1rem;
    }

    .hero-urgida-subtitle {
      font-size: 1.1rem;
      color: var(--text-muted);
      margin-bottom: 2rem;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    .hero-urgida-ctas {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 2rem;
    }

    .cta-primary, .cta-secondary, .cta-tertiary {
      padding: 1rem 1.5rem;
      border-radius: 12px;
      text-decoration: none;
      font-weight: 700;
      transition: var(--transition);
      display: inline-block;
    }

    .cta-primary {
      background: linear-gradient(135deg, var(--blue), var(--orange));
      color: white;
      box-shadow: var(--shadow-lg);
    }

    .cta-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 15px 30px rgba(37, 99, 235, 0.3);
    }

    .cta-secondary {
      background: var(--bg-alt);
      color: var(--text-dark);
      border: 2px solid var(--blue);
    }

    .cta-secondary:hover {
      background: var(--blue);
      color: white;
    }

    .cta-tertiary {
      background: transparent;
      color: var(--blue);
      border: 2px solid var(--blue);
    }

    .cta-tertiary:hover {
      background: var(--blue);
      color: white;
    }

    .search-hero {
      margin: 2rem 0;
      position: relative;
    }

    .quick-search-input {
      width: 100%;
      padding: 1rem;
      border: 2px solid var(--border-light);
      border-radius: 12px;
      font-size: 1rem;
      background: var(--bg-alt);
      color: var(--text-dark);
      transition: var(--transition);
    }

    .quick-search-input:focus {
      outline: none;
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .search-results {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--bg-light);
      border: 2px solid var(--border-light);
      border-top: none;
      border-radius: 0 0 12px 12px;
      max-height: 300px;
      overflow-y: auto;
      z-index: 10;
    }

    .search-results.hidden {
      display: none;
    }

    .search-result-item {
      display: block;
      padding: 1rem;
      border-bottom: 1px solid var(--border-light);
      text-decoration: none;
      color: var(--text-dark);
      transition: var(--transition);
    }

    .search-result-item:hover {
      background: var(--bg-alt);
      color: var(--blue);
    }

    .etapa-navigator {
      background: var(--bg-alt);
      border-radius: 16px;
      padding: 2rem;
      margin: 3rem 0;
    }

    .etapa-navigator h2 {
      text-align: center;
      margin-bottom: 0.5rem;
    }

    .etapa-navigator > p {
      text-align: center;
      color: var(--text-muted);
      margin-bottom: 2rem;
    }

    .etapa-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 1rem;
    }

    .etapa-card {
      background: var(--bg-light);
      border: 2px solid var(--border-light);
      border-radius: 12px;
      padding: 1.5rem 1rem;
      text-align: center;
      text-decoration: none;
      color: var(--text-dark);
      transition: var(--transition);
      cursor: pointer;
    }

    .etapa-card:hover, .etapa-card.active {
      border-color: var(--blue);
      box-shadow: var(--shadow-lg);
      transform: translateY(-4px);
    }

    .etapa-icon {
      font-size: 2rem;
      display: block;
      margin-bottom: 0.5rem;
    }

    .etapa-card strong {
      display: block;
      margin-bottom: 0.25rem;
    }

    .etapa-card small {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .featured-section {
      background: linear-gradient(135deg, rgba(37, 99, 235, 0.05) 0%, rgba(249, 115, 22, 0.05) 100%);
      border-radius: 16px;
      padding: 2rem;
      margin: 3rem 0;
      border: 2px solid rgba(37, 99, 235, 0.2);
    }

    .featured-section h2 {
      text-align: center;
      margin-bottom: 0.5rem;
    }

    .featured-section > p {
      text-align: center;
      color: var(--text-muted);
      margin-bottom: 2rem;
    }

    .featured-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
    }

    .featured-card {
      background: var(--bg-light);
      border: 2px solid var(--border-light);
      border-radius: 12px;
      padding: 1.5rem;
      position: relative;
      transition: var(--transition);
    }

    .featured-card:hover {
      border-color: var(--blue);
      box-shadow: var(--shadow-lg);
      transform: translateY(-8px);
    }

    .featured-card h3 {
      margin: 1rem 0 0.5rem;
    }

    .featured-card p {
      font-size: 0.95rem;
      margin: 0.5rem 0;
      color: var(--text-muted);
    }

    .read-more {
      display: inline-block;
      margin-top: 1rem;
      color: var(--blue);
      text-decoration: none;
      font-weight: 600;
      transition: var(--transition);
    }

    .read-more:hover {
      color: var(--orange);
    }

    .categories-quick {
      background: var(--bg-alt);
      border-radius: 16px;
      padding: 2rem;
      margin: 2rem 0;
    }

    .categories-quick h2 {
      margin-bottom: 1.5rem;
    }

    /* SIDEBAR NAVIGATION */
    .page-with-sidebar {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 1.5rem;
      max-width: 1400px;
      margin: 0 auto;
    }

    .sidebar-nav {
      position: sticky;
      top: 100px;
      height: fit-content;
      background: var(--bg-alt);
      border-radius: 12px;
      padding: 1.5rem;
      border: 2px solid var(--border-light);
    }

    .toggle-sidebar-btn {
      display: none;
      background: none;
      border: none;
      font-size: 1.5rem;
      cursor: pointer;
      margin-bottom: 1rem;
    }

    .sidebar-content {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .sidebar-content h3 {
      margin: 0;
      font-size: 1rem;
      font-family: 'Poppins', sans-serif;
    }

    .filter-group {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .filter-label {
      font-weight: 700;
      font-size: 0.9rem;
      color: var(--text-dark);
    }

    .filter-options {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .filter-checkbox {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
      font-size: 0.9rem;
      color: var(--text-muted);
      transition: var(--transition);
    }

    .filter-checkbox:hover {
      color: var(--blue);
    }

    .filter-checkbox input {
      cursor: pointer;
      accent-color: var(--blue);
    }

    .clear-filters-btn {
      padding: 0.75rem 1rem;
      background: linear-gradient(135deg, var(--blue), var(--orange));
      color: white;
      border: none;
      border-radius: 8px;
      font-weight: 700;
      cursor: pointer;
      transition: var(--transition);
    }

    .clear-filters-btn:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .sidebar-stats {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 0.75rem;
      padding-top: 1.5rem;
      border-top: 2px solid var(--border-light);
    }

    .stat-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
    }

    .stat-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      font-weight: 700;
    }

    .stat-value {
      font-size: 1.5rem;
      font-weight: 700;
      background: linear-gradient(135deg, var(--blue), var(--orange));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .main-content {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    /* CARD HIERARCHY */
    .card {
      background: var(--bg-light);
      border: 1px solid var(--border-light);
      border-radius: 12px;
      padding: 1.25rem;
      transition: all 0.3s ease;
    }

    .card:hover {
      border-color: var(--blue);
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }

    .card-pillar {
      border: 2px solid transparent;
      background: linear-gradient(var(--bg-light), var(--bg-light)) padding-box,
                  linear-gradient(135deg, var(--blue), var(--orange)) border-box;
      padding: 1.5rem;
      box-shadow: var(--shadow-md);
      position: relative;
    }

    .card-pillar:hover {
      box-shadow: 0 12px 24px rgba(37, 99, 235, 0.2);
      transform: translateY(-4px);
    }

    .card-pillar .pillar-badge {
      background: linear-gradient(135deg, var(--blue), var(--orange));
      color: white !important;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 0.35rem 0.85rem;
      border-radius: 20px;
      display: inline-block;
      margin-left: 0.5rem;
    }

    @media (max-width: 1024px) {
      .page-with-sidebar {
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      .sidebar-nav {
        position: static;
        display: none;
      }

      .sidebar-nav.active {
        display: block;
      }

      .toggle-sidebar-btn {
        display: block;
      }
    }

    @media (max-width: 640px) {
      .hero-urgida {
        padding: 2rem 1rem;
      }

      .hero-urgida h1 {
        font-size: 1.75rem;
      }

      .hero-urgida-ctas {
        flex-direction: column;
      }

      .cta-primary, .cta-secondary, .cta-tertiary {
        width: 100%;
        text-align: center;
      }

      .etapa-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .featured-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- CLOSE MAIN CONTENT AND PAGE WITH SIDEBAR -->
    </main>
  </div>

  <!-- FILTER & ANALYTICS SCRIPT -->
  <script is:inline>
    const filterRadios = document.querySelectorAll('input[type="radio"]');
    const clearBtn = document.getElementById('clear-filters');
    const toggleSidebarBtn = document.getElementById('toggle-sidebar');
    const sidebarNav = document.querySelector('.sidebar-nav');
    const articleCount = document.getElementById('article-count');

    // Toggle sidebar en mobile
    if (toggleSidebarBtn) {
      toggleSidebarBtn.addEventListener('click', () => {
        sidebarNav.classList.toggle('active');
      });
    }

    // Event listeners para filtros
    filterRadios.forEach(radio => {
      radio.addEventListener('change', applyFilters);
    });

    // Limpiar filtros
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        filterRadios.forEach(r => {
          if (r.value === 'all') r.checked = true;
        });
        applyFilters();
      });
    }

    function applyFilters() {
      const category = document.querySelector('input[name="category"]:checked')?.value || 'all';
      const etapa = document.querySelector('input[name="etapa"]:checked')?.value || 'all';
      const level = document.querySelector('input[name="level"]:checked')?.value || 'all';

      const cards = document.querySelectorAll('.card');
      let visibleCount = 0;

      cards.forEach(card => {
        const cardCategory = card.getAttribute('data-category') || '';
        const cardEtapa = card.getAttribute('data-etapa') || '';
        const cardLevel = card.getAttribute('data-level') || '';

        const matchCategory = category === 'all' || cardCategory === category;
        const matchEtapa = etapa === 'all' || cardEtapa === etapa;
        const matchLevel = level === 'all' || cardLevel === level;

        if (matchCategory && matchEtapa && matchLevel) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (articleCount) {
        articleCount.textContent = visibleCount;
      }

      // Analytics
      console.log(`Filters applied: category=${category}, etapa=${etapa}, level=${level}, visible=${visibleCount}`);
    }

    // Inicializar contador
    if (articleCount) {
      articleCount.textContent = document.querySelectorAll('.card').length;
    }
  </script>
</Layout>
