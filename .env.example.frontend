# Frontend Environment Variables
# Copy to .env.local and configure for your environment

# API Configuration
PUBLIC_API_URL=http://localhost:3000
PUBLIC_WEBSOCKET_URL=ws://localhost:3000

# Environment
PUBLIC_ENV=development

# Feature Flags
PUBLIC_ENABLE_NOTIFICATIONS=true
PUBLIC_ENABLE_NEWSLETTER=true
PUBLIC_ENABLE_EXPERT_VERIFICATION=true

# Analytics (GA4)
PUBLIC_GA_ID=
PUBLIC_ENABLE_GA=false

# Sentry Error Tracking
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=development

# Feature Settings
PUBLIC_MODERATION_ENABLED=true
PUBLIC_EXPERT_BADGE_ENABLED=true
PUBLIC_DARK_MODE_DEFAULT=system
